# ===== 复制本文件为 .env 并填入你自己的值 =====

# 天地图地图瓦片key(多个用英文逗号分隔)
TIANDITU_KEYS=your_tianditu_key1,your_tianditu_key2
# 高德开放平台key(POI数据)
AMAP_KEY=your_amap_key
# RollingGo 交通数据key
ROLLINGGO_KEY=your_rollinggo_key

# ===== JWT(用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成) =====
JWT_SECRET_KEY=your_random_secret_at_least_32_bytes

# ===== 发验证码的QQ邮箱(QQ邮箱设置里开启SMTP并生成授权码) =====
MAIL_USERNAME=your_qq_number@qq.com
MAIL_PASSWORD=your_smtp_auth_code
MAIL_FROM=your_qq_number@qq.com
MAIL_PORT=465
MAIL_SERVER=smtp.qq.com
MAIL_SSL=True
MAIL_STARTTLS=False

# ===== MySQL =====
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tracord
